# ---------- required ----------
# Public URL of the deployed app (no trailing slash). Sign-in messages are pinned to this host in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Postgres (Neon etc.). Leave empty locally to use embedded PGlite in .data/pglite.
DATABASE_URL=
# >= 32 random chars: `openssl rand -hex 32`
SESSION_SECRET=

# ---------- chain (defaults are Mezo Testnet) ----------
NEXT_PUBLIC_MEZO_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MUSD_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503
# Blocks a Transfer must be buried under before a tip is confirmed.
CONFIRMATIONS=1

# ---------- wallets ----------
# WalletConnect Cloud project id — enables mobile wallets + QR pairing. Optional but recommended.
NEXT_PUBLIC_WC_PROJECT_ID=
# Extra hosts allowed in sign-in messages (comma-separated), e.g. a Vercel preview host.
SIWE_EXTRA_DOMAINS=

# ---------- indexer / jobs ----------
# Bearer token for POST /api/indexer/sync (external cron) and GET /api/cron (Vercel Cron).
INDEXER_SECRET=
CRON_SECRET=
# First block to scan (defaults to head - INDEXER_BOOTSTRAP_BLOCKS on first run).
INDEXER_START_BLOCK=
INDEXER_BOOTSTRAP_BLOCKS=5000
INDEXER_MAX_BLOCKS=20000
REORG_WINDOW=20
SUBMITTED_TIMEOUT_SECONDS=1800
WORKER_INTERVAL_MS=10000
DB_POOL_MAX=5
# Optional: keep tables in their own schema when sharing one Postgres (e.g. Supabase) with other apps.
DB_SCHEMA=

# ---------- x402 (optional machine-payment rail, see docs/X402.md) ----------
X402_ENABLED=0
X402_FACILITATOR_URL=https://facilitator.vativ.io
X402_FACILITATOR_TIMEOUT_MS=
X402_RATE_LIMIT_PER_MINUTE=
# Server-side RPC override for x402 verification (defaults to NEXT_PUBLIC_MEZO_RPC_URL).
MEZO_RPC_URL=
# Only for scripts/x402-tip.ts — never set on the server.
X402_PAYER_PRIVATE_KEY=
X402_PAYER_NAME=
